# Vereon — Supabase Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is excluded from git and must never be committed.
#
# Find these values in your Supabase project:
# Settings → API → Project URL and Project API Keys (anon / public)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY is intentionally not listed here.
# It bypasses Row Level Security completely and must never appear
# in Next.js application code, .env.example, or any committed file.
# Use it only via the Supabase CLI for migrations and admin scripts.
